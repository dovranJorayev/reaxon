{
  "name": "@reaxon/tanstack-query-mobx",
  "version": "0.1.0",
  "description": "MobX reactive wrappers for TanStack Query observers",
  "keywords": ["mobx", "tanstack-query", "query-core", "react-query", "reactive", "resource"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dovranJorayev/reaxon.git",
    "directory": "packages/tanstack-query-mobx"
  },
  "homepage": "https://github.com/dovranJorayev/reaxon/tree/main/packages/tanstack-query-mobx#readme",
  "bugs": "https://github.com/dovranJorayev/reaxon/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^4.13.0",
    "mobx": "^6.10.0"
  },
  "devDependencies": {
    "@tanstack/query-core": "4.44.0",
    "mobx": "6.16.1",
    "mobx-utils": "6.1.1"
  }
}
